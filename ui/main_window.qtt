/* ── Base ── */
QMainWindow,
QWidget {
  background-color: #16161a;
  color: #d4cfc8;
  font-size: 13px;
}

/* ── Combo ── */
QComboBox {
  background: #16161a;
  border: 1px solid #333340;
  border-radius: 5px;
  padding: 5px 10px;
  min-height: 28px;
  color: #d4cfc8;
}
QComboBox:hover {
  border-color: #b8962e;
}
QComboBox::drop-down {
  border: none;
  width: 24px;
}
QComboBox::down-arrow {
  width: 0;
}
QComboBox QAbstractItemView {
  background: #16161a;
  border: 1px solid #333340;
  padding: 2px;
}

/* ── Slot list ── */
QListWidget {
  background: #16161a;
  border: 1px solid #2a2a32;
  border-radius: 6px;
  outline: none;
}
QListWidget::item {
  border-bottom: 1px solid #111116;
}
QListWidget::item:selected {
  background: #292957;
}


/* ── Buttons — default ── */
QPushButton {
  background: #1f1f25;
  border: 1px solid #333340;
  border-radius: 5px;
  padding: 6px 16px;
  color: #d4cfc8;
  min-height: 28px;
}
QPushButton:hover {
  background: #2a2a32;
  border-color: #555566;
}
QPushButton:pressed {
  background: #151518;
}

/* ── Primary button ── */
QPushButton#primaryBtn {
  background: #b8962e;
  border-color: #b8962e;
  color: #111;
  font-weight: 600;
}
QPushButton#primaryBtn:hover {
  background: #cda83a;
  border-color: #cda83a;
}
QPushButton#primaryBtn:pressed {
  background: #9a7c24;
}

/* ── Danger button ── */
QPushButton#dangerBtn {
  color: #c0605a;
  border-color: #3a2020;
}
QPushButton#dangerBtn:hover {
  background: #2a1818;
  border-color: #c0605a;
  color: #d97070;
}

/* ── Ghost button ── */
QPushButton#ghostBtn {
  background: transparent;
  border-color: #2a2a32;
  color: #888899;
}
QPushButton#ghostBtn:hover {
  background: #1f1f25;
  border-color: #444455;
  color: #d4cfc8;
}
/* Small icon-only buttons (the + next to Game and Profile): no side padding, or a fixed
   narrow width leaves no room for the icon. */
QPushButton#ghostBtn[iconOnly="true"] {
  padding: 0;
}
QPushButton#ghostBtn:checked {
  background: #2a1f0a;
  border-color: #b8962e;
  color: #b8962e;
}

/* ── Labels ── */
QLabel {
  background-color: transparent;
}

QLabel#panelHeader {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #555566;
}
QLabel#fieldLabel {
  font-size: 11px;
  color: #666677;
  font-weight: 500;
}
QLabel#mutedLabel {
  font-size: 11px;
  color: #555566;
}
QLabel#detailName {
  font-size: 16px;
  font-weight: 600;
  color: #e8e2d8;
}
QLabel#detailNotes {
  color: #888899;
  font-size: 12px;
  line-height: 1.5;
}

/* ── Text inputs ── */
QLineEdit {
  background: #16161a;
  border: 1px solid #333340;
  border-radius: 5px;
  padding: 5px 10px;
  min-height: 28px;
  color: #d4cfc8;
}
QLineEdit:hover {
  border-color: #555566;
}
QLineEdit:focus {
  border-color: #b8962e;
}

QPlainTextEdit#detailNotes {
  background: #16161a;
  border: 1px solid #333340;
  border-radius: 5px;
  padding: 8px 10px;
  color: #d4cfc8;
  font-size: 12px;
}
QPlainTextEdit#detailNotes:focus {
  border-color: #b8962e;
}

/* ── Info box ── */
QFrame#infoBox {
  background: #16161a;
  border: 1px solid #2a2a32;
  border-radius: 6px;
}

/* ── Splitter handle ── */
QSplitter::handle {
  background: #2a2a32;
}

/* ── Status bar ── */
QStatusBar {
  background: #16161a;
  color: #555566;
  font-size: 11px;
  border-top: 1px solid #2a2a32;
}

/* ── Checkboxes and radio buttons ── */
QCheckBox, QRadioButton {
  background: transparent;
  color: #d4cfc8;
  spacing: 8px;
  font-size: 13px;
}
QCheckBox::indicator, QRadioButton::indicator {
  width: 14px;
  height: 14px;
  border: 2px solid #8a8aa0;
  background: #26262e;
}
QCheckBox::indicator {
  border-radius: 4px;
}
QRadioButton::indicator {
  border-radius: 9px;
}
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
  border-color: #d4b24a;
}
QCheckBox::indicator:checked {
  background: #b8962e;
  border-color: #b8962e;
  image: url({ui_dir}/check.svg);
}
QRadioButton::indicator:checked {
  border-color: #b8962e;
  background: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5,
    stop:0 #16161a, stop:0.3 #16161a,
    stop:0.4 #b8962e, stop:1 #b8962e);
}

/* ── Scrollbar ── */
QScrollBar:vertical {
  background: #1b1b21;
  width: 14px;
  margin: 0;
  border: none;
}
QScrollBar::handle:vertical {
  background: #4d4d60;
  border-radius: 5px;
  min-height: 40px;
  margin: 2px;
}
QScrollBar::handle:vertical:hover {
  background: #6e6e88;
}
QScrollBar::handle:vertical:pressed {
  background: #b8962e;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
  height: 0;
  border: none;
  background: none;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
  background: none;
}
QScrollBar:horizontal {
  background: #1b1b21;
  height: 14px;
  margin: 0;
  border: none;
}
QScrollBar::handle:horizontal {
  background: #4d4d60;
  border-radius: 5px;
  min-width: 40px;
  margin: 2px;
}
QScrollBar::handle:horizontal:hover {
  background: #6e6e88;
}
QScrollBar::handle:horizontal:pressed {
  background: #b8962e;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
  width: 0;
  border: none;
  background: none;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
  background: none;
}

/* ── Context menu ── */
QMenu {
  background: #1f1f25;
  border: 1px solid #333340;
  border-radius: 6px;
  padding: 4px 0;
}
QMenu::item {
  padding: 6px 24px 6px 12px;
  color: #d4cfc8;
  border-radius: 3px;
  margin: 1px 4px;
}
QMenu::item:selected {
  background: #2a2a38;
}
QMenu::item:disabled {
  color: #555566;
}
QMenu::separator {
  height: 1px;
  background: #2a2a32;
  margin: 4px 8px;
}
